__pycache__/
*.pyc

checkpoints/
checkpoints_backup/

*.egg-info/

# Python packaging / test caches
build/
dist/
.pytest_cache/

# Frontend build output and dependencies
frontend/node_modules/
frontend/.next/
frontend/out/
# TypeScript's incremental build cache. Generated by `next build` and by the
# Docker image build, so a tracked copy re-dirties the tree on every build and
# shows up in every diff as noise.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Runtime output: index rasters, evidence packs, the SQLite run store
artifacts/
*.db

# Stray rasters dropped at the repository root by manual API probing. Only the
# root: real imagery lives under data/ (already ignored) and test fixtures are
# written to pytest tmp directories.
/*.tif
/*.tiff

# Local environment / secrets
.env
.env.*

# Datasets and downloaded satellite products. Never commit these: they are
# large binaries, and per docs/03 section 4.3 the Bhoonidhi products are a
# held-out cross-sensor generalisation set that must never be trained on.
data/
models/

# `models/` above is meant for downloaded weights, but it matches at any depth,
# and that silently swallowed the /models Next.js route - the page whose
# absence was the live 404 the header linked to. The directory has to be
# re-included before the file inside it can be: git will not re-include a file
# whose parent directory is still excluded.
!frontend/app/models/
!frontend/app/models/**
